# Postgres connection string (self-hosted Postgres on Hetzner via PgBouncer).
# IMPORTANT: use the hostname `pg.billedetiltekst.dk:6432`, NOT the bare IP.
# Cloudflare Workers cannot complete a TLS handshake to a bare IP through
# PgBouncer — the connection hangs and the request is canceled after ~15s.
# Format: postgres://<app_role>:<password>@pg.billedetiltekst.dk:6432/<db>?sslmode=require
DATABASE_URL=postgres://<app_role>:<password>@pg.billedetiltekst.dk:6432/<db>?sslmode=require

# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here

# Public app URL (used as Better Auth baseURL)
PUBLIC_APP_URL=http://localhost:5173

# Google Analytics 4 measurement ID.
PUBLIC_GA_MEASUREMENT_ID=G-9K8CQ4KZ1F

# Cloudflare R2 storage (invoice PDFs and logos) is configured via the
# `INVOICES_BUCKET` binding in wrangler.jsonc — no environment variable needed.
# Create the bucket with:
#   npx wrangler r2 bucket create skabelontilfaktura-invoices

# Secret token required to invoke the /api/jobs/reminders cron route.
# Generate with: openssl rand -base64 32
CRON_SECRET=your-cron-secret-here

# Maileroo API key for transactional email delivery.
MAILEROO_API_KEY=your-maileroo-api-key

# Verified Maileroo sender address for transactional email.
EMAIL_FROM=noreply@skabelontilfaktura.dk

# Autumn (useautumn.com) secret API key — sandbox (`am_sk_test_...`) or live
# (`am_sk_live_...`). The key must include the `billing:write` scope (create it
# in the dashboard: Developer → API keys → "Restricted mode" off, or on with
# Billing → Write). Keys minted by `atmn login` do NOT include billing:write.
AUTUMN_SECRET_KEY=your-autumn-secret-key

# Autumn webhook signing secret (`whsec_...`) from Dashboard → Developer →
# Webhooks → endpoint → signing secret. Used to verify /api/autumn/webhook.
AUTUMN_WEBHOOK_SECRET=your-autumn-webhook-secret

# Fakturapakken paid pilot: DKK 99 gross = DKK 79.20 net + DKK 19.80 VAT.
# Keep closed until the approved sandbox purchase-to-download and refund gates
# pass and the LIVE webhook, catalog, seller/VAT details and document delivery
# are verified. No global tax/default-setting changes are made by the app.
KIT_CHECKOUT_ENABLED=false
# Environment-scoped Stripe tax rate: active, Danish VAT 25%, INCLUSIVE.
# The exact mapped Stripe price must be provisioned for fakturapakken_v1.
# Verify an unpaid checkout totals 9900 minor units, VAT 1980, net 7920 before
# enabling. An exclusive rate or automatic-tax organization setting is unsafe.
KIT_VAT_RATE_ID=
